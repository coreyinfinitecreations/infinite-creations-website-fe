+++ b/src/pages/Services.css
@@ -0,0 +1,301 @@
+/* Services Page Styles */
+.services-page {
+  min-height: 100vh;
+}
+
+/* Hero */
+.services-hero {
+  background: linear-gradient(135deg, #ff4444 0%, #cc3333 100%);
+  color: white;
+  padding: 120px 0 80px;
+  text-align: center;
+}
+
+.services-hero .hero-content {
+  max-width: 800px;
+  margin: 0 auto;
+  padding: 0 20px;
+}
+
+.services-hero .hero-title {
+  font-size: 3.5rem;
+  font-weight: 700;
+  margin-bottom: 20px;
+  letter-spacing: -0.02em;
+}
+
+.services-hero .hero-description {
+  font-size: 1.25rem;
+  line-height: 1.6;
+  color: rgba(255, 255, 255, 0.9);
+  margin: 0 0 32px;
+}
+
+/* Plans */
+.services-plans {
+  padding: 80px 0;
+  background: #fff;
+}
+
+.services-plans .container,
+.services-projects .container {
+  max-width: 1200px;
+  margin: 0 auto;
+  padding: 0 20px;
+}
+
+.services-plans .section-title,
+.services-projects .section-title {
+  text-align: center;
+  font-size: 2.5rem;
+  font-weight: 700;
+  margin-bottom: 12px;
+  color: #333;
+}
+
+.services-plans .section-subtitle,
+.services-projects .section-subtitle {
+  text-align: center;
+  font-size: 1.15rem;
+  line-height: 1.6;
+  color: #666;
+  max-width: 700px;
+  margin: 0 auto 50px;
+}
+
+.plans-grid {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
+  gap: 30px;
+  align-items: stretch;
+}
+
+.plan-card {
+  position: relative;
+  background: #ffffff;
+  border: 1px solid #e9ecef;
+  border-radius: 12px;
+  padding: 40px 32px;
+  display: flex;
+  flex-direction: column;
+  box-shadow: 0 5px 15px rgba(0, 0, 0, 0.08);
+  transition: transform 0.3s ease, box-shadow 0.3s ease;
+}
+
+.plan-card:hover {
+  transform: translateY(-5px);
+  box-shadow: 0 15px 30px rgba(0, 0, 0, 0.12);
+}
+
+.plan-card-highlighted {
+  border: 2px solid #ff4444;
+}
+
+.plan-badge {
+  position: absolute;
+  top: -14px;
+  left: 50%;
+  transform: translateX(-50%);
+  background: #ff4444;
+  color: #fff;
+  font-size: 0.8rem;
+  font-weight: 700;
+  text-transform: uppercase;
+  letter-spacing: 0.06em;
+  padding: 6px 16px;
+  border-radius: 20px;
+  white-space: nowrap;
+}
+
+.plan-name {
+  font-size: 1.35rem;
+  font-weight: 700;
+  color: #333;
+  margin-bottom: 8px;
+}
+
+.plan-price {
+  font-size: 2.5rem;
+  font-weight: 700;
+  color: #1a1a1a;
+  margin: 0 0 4px;
+}
+
+.plan-unit {
+  font-size: 1rem;
+  font-weight: 500;
+  color: #999;
+  margin-left: 4px;
+}
+
+.plan-tagline {
+  font-size: 1rem;
+  line-height: 1.6;
+  color: #666;
+  margin-bottom: 24px;
+}
+
+.plan-features,
+.project-features {
+  list-style: none;
+  margin: 0 0 32px;
+  padding: 0;
+  flex: 1;
+}
+
+.plan-features li,
+.project-features li {
+  position: relative;
+  padding-left: 28px;
+  margin-bottom: 12px;
+  font-size: 0.98rem;
+  line-height: 1.5;
+  color: #555;
+}
+
+.plan-features li::before,
+.project-features li::before {
+  content: "✓";
+  position: absolute;
+  left: 0;
+  color: #ff4444;
+  font-weight: 700;
+}
+
+.btn-plan-secondary {
+  background: transparent;
+  color: #ff4444;
+  border: 2px solid #ff4444;
+  padding: 12px 30px;
+  font-size: 1.05rem;
+  font-weight: 600;
+  border-radius: 8px;
+  cursor: pointer;
+  transition: background 0.3s ease, color 0.3s ease, transform 0.2s ease;
+}
+
+.btn-plan-secondary:hover {
+  background: #ff4444;
+  color: #fff;
+  transform: translateY(-2px);
+}
+
+.plans-terms {
+  max-width: 800px;
+  margin: 50px auto 0;
+  padding: 24px 28px;
+  background: #f8f9fa;
+  border-radius: 12px;
+  text-align: center;
+}
+
+.plans-terms p {
+  margin: 0;
+  font-size: 1rem;
+  line-height: 1.7;
+  color: #555;
+}
+
+/* Website projects */
+.services-projects {
+  padding: 80px 0;
+  background: #fafafa;
+}
+
+.projects-grid {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
+  gap: 30px;
+}
+
+.project-card {
+  background: #fff;
+  border: 1px solid #e9ecef;
+  border-radius: 12px;
+  padding: 40px 32px;
+  display: flex;
+  flex-direction: column;
+  box-shadow: 0 5px 15px rgba(0, 0, 0, 0.08);
+  transition: transform 0.3s ease, box-shadow 0.3s ease;
+}
+
+.project-card:hover {
+  transform: translateY(-5px);
+  box-shadow: 0 15px 30px rgba(0, 0, 0, 0.12);
+}
+
+.project-name {
+  font-size: 1.35rem;
+  font-weight: 700;
+  color: #333;
+  margin-bottom: 8px;
+}
+
+.project-price {
+  font-size: 2.25rem;
+  font-weight: 700;
+  color: #1a1a1a;
+  margin: 0 0 4px;
+}
+
+.project-unit {
+  display: block;
+  font-size: 1rem;
+  font-weight: 500;
+  color: #999;
+}
+
+.project-tagline {
+  font-size: 1rem;
+  line-height: 1.6;
+  color: #666;
+  margin-bottom: 24px;
+}
+
+/* CTA */
+.services-cta {
+  padding: 80px 0;
+  background: #1a1a1a;
+  color: white;
+  text-align: center;
+}
+
+.services-cta .container {
+  max-width: 800px;
+  margin: 0 auto;
+  padding: 0 20px;
+}
+
+.btn-cta-primary {
+  background: #ff4444;
+  color: white;
+  border: none;
+  padding: 14px 32px;
+  font-size: 1.05rem;
+  font-weight: 600;
+  border-radius: 8px;
+  cursor: pointer;
+  transition: background 0.3s ease, transform 0.2s ease;
+}
+
+.btn-cta-primary:hover {
+  background: #e63939;
+  transform: translateY(-2px);
+}
+
+/* Responsive */
+@media (max-width: 768px) {
+  .services-hero .hero-title {
+    font-size: 2.5rem;
+  }
+
+  .services-plans .section-title,
+  .services-projects .section-title {
+    font-size: 2rem;
+  }
+
+  .plans-grid,
+  .projects-grid {
+    grid-template-columns: 1fr;
+  }
+}
diff --git a/src/pages/Services.jsx b/src/pages/Services.jsx
